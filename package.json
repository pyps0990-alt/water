{
  "name": "water-engineering-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-water 'vitest run tests/rules.test.ts'",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only functions,firestore,storage --project demo-water 'node scripts/smoke-functions.mjs'",
    "emulators": "firebase emulators:start --project demo-water",
    "test:unit": "vitest run tests/print.test.ts"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "firebase": "^13.4.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "firebase-tools": "^15.36.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
