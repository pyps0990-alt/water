rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are listed in /admins/{email} (managed in the Firebase console or by the
    // deploy workflow), so no account appears in this public repository.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Cases are created only by the `createCase` Cloud Function (Admin SDK),
    // which assigns the case ID, enforces maxWeeklyCases and bumps
    // schedules.bookedCount in one transaction. Public status lookup goes
    // through `getCaseStatus`. Clients never touch this collection.
    match /cases/{caseId} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.status in ['arranging', 'pending_survey', 'quoting', 'in_progress', 'unpaid', 'final_paid']
        && request.resource.data.caseId == resource.data.caseId
        && request.resource.data.clientInfo.phone == resource.data.clientInfo.phone;
      allow create: if false;
    }

    match /schedules/{dateId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.dayStatus in ['available', 'busy', 'closed'];
    }

    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Holds `global` (public config) and `reviews` (cached Google reviews).
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // An admin may read their own entry; the list is never writable from clients.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // Internal counters (case ID sequence etc.) — functions only.
    match /counters/{docId} {
      allow read, write: if false;
    }
  }
}
